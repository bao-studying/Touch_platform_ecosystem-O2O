PORT=5001

# ==== QUAN TRỌNG: BẮT BUỘC trùng với Client Server ====
# Dùng CHUNG 1 database — Admin Server và Client Server phải trỏ về đúng 1 MONGO_URI.
MONGO_URI=mongodb://127.0.0.1:27017/o2o_brand

# BẮT BUỘC trùng với JWT_SECRET của Client Server — để token tenant tạo ở đâu cũng dùng được ở kia
# (dùng cho: đăng nhập tenant trên trang giới thiệu, "Login as User" của Super Admin).
JWT_SECRET=change_this_to_the_SAME_secret_as_client_server

# Secret JWT RIÊNG cho Super Admin — CHỈ Admin Server biết, không chia sẻ với Client Server
SUPER_ADMIN_JWT_SECRET=change_this_to_a_different_long_random_secret

# URL Client Server (BE) — Admin Server gọi sang đây để lấy tài khoản nhận tiền SePay dùng chung (GET /api/payments/bank-info)
CLIENT_SERVER_URL=http://localhost:5000

# URL Client Web (FE app khách hàng) — dùng để tạo link "Vào Dashboard", "Tiếp tục thiết lập", link "Đăng nhập" ở Navbar
CLIENT_WEB_URL=http://localhost:5173

# URL Admin Web (FE trang giới thiệu + Super Admin) — dùng cho CORS
ADMIN_WEB_URL=http://localhost:5174

# Tài khoản Super Admin đầu tiên — tự tạo khi server khởi động lần đầu (nếu chưa có Super Admin nào)
# Đây CŨNG là Email + Mật khẩu dùng cho cơ chế đăng nhập ẩn "Easter Egg" ở Form Liên hệ công khai.
SUPER_ADMIN_SEED_EMAIL=owner@o2obrand.local
SUPER_ADMIN_SEED_PASSWORD=ChangeMe123!

# Email xác thực đăng ký (Nodemailer) — để trống thì tự in link ra console (chế độ demo)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=O2O Brand Platform

# ==== SePay (chuyển khoản online) — DÙNG CHUNG với Client Server, KHÔNG cần cấu hình webhook thứ 2 ====
# SePay chỉ có 1 webhook (link ngrok/domain của bạn → Client Server). Giao dịch của đơn vật phẩm decor (mã O2OHW...)
# được Client Server tự chuyển tiếp sang Admin Server bằng JWT_SECRET dùng chung ở trên.
# Tài khoản nhận tiền (SEPAY_BANK_ID/ACCOUNT_NO/ACCOUNT_NAME) cũng được tự lấy từ Client Server qua CLIENT_SERVER_URL.
# CHỈ điền 3 biến dưới đây nếu muốn Admin Server dùng tài khoản KHÁC (cùng tên biến với Client Server):
SEPAY_BANK_ID=
SEPAY_ACCOUNT_NO=
SEPAY_ACCOUNT_NAME=
