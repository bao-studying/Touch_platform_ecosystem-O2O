PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/o2o_brand
JWT_SECRET=change_this_to_a_long_random_secret
CLIENT_URL=http://localhost:5173

# Admin Server (nền tảng quản trị Super Admin, repo/server RIÊNG) — dùng chung 1 MongoDB
# (MONGO_URI phải TRÙNG với Admin Server) và CHUNG JWT_SECRET (để token đăng nhập dùng lại được
# ở cả 2 bên). Backend gọi sang đây lúc tạo đơn thanh toán để lấy giá gói THẬT (xem
# utils/adminServerClient.js) — không bắt buộc phải chạy Admin Server khi phát triển tính năng
# không liên quan đến giá/thanh toán, khi đó hệ thống tự dùng giá dự phòng trong config/planPricing.js.
ADMIN_SERVER_URL=http://localhost:5001

# SePay — thông tin tài khoản nhận chuyển khoản, hiển thị trong modal thanh toán nâng cấp gói.
# SEPAY_BANK_ID: mã ngân hàng theo chuẩn VietQR (BIN, VD 970422 cho MB Bank) hoặc tên rút gọn img.vietqr.io hỗ trợ.
SEPAY_BANK_ID=
SEPAY_ACCOUNT_NO=
SEPAY_ACCOUNT_NAME=
# NÊN đặt: token này TRÙNG với API Key cấu hình bên SePay dashboard để webhook xác thực 2 chiều. Để trống thì ai biết URL
# webhook cũng gửi được thanh toán giả (server sẽ in cảnh báo khi khởi động).
#
# Webhook SePay của bạn (link ngrok/domain → POST /api/payments/webhook/sepay) dùng cho CẢ HAI loại thanh toán:
#   • nâng cấp gói (mã O2O<mã DN><GÓI>...)        → xử lý tại đây
#   • vật phẩm decor mua ở Admin Web (mã O2OHW...) → tự chuyển tiếp sang ADMIN_SERVER_URL (không cần cấu hình webhook thứ 2)
# Admin Server cũng tự đọc tài khoản nhận tiền ở trên qua GET /api/payments/bank-info nên dùng chung 1 mã QR.
SEPAY_WEBHOOK_TOKEN=
